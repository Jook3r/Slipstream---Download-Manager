{
  "identifier": "default",
  "description": "What Slipstream's windows may call",
  "windows": [
    "main",
    "info-*",
    "progress-*",
    "batch-*",
    "scheduler",
    "countdown"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
